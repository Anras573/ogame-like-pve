              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/seasons/current/join": {
      "post": {
        "tags": [
          "Seasons"
        ],
        "description": "Join the season that is open right now",
