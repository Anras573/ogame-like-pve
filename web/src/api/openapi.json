          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "tokenType": {
            "type": [
              "null",
              "string"
            ]
          },
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          },
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "BuildingDto": {
        "required": [
          "type",
          "level",
          "nextLevelCost",
          "nextLevelBuildSeconds"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/BuildingType"
          },
          "level": {
            "type": "integer",
            "format": "int32"
          },
          "nextLevelCost": {
            "$ref": "#/components/schemas/ResourcesDto"
          },
          "nextLevelBuildSeconds": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "BuildingType": {
        "enum": [
          "MetalMine",
          "CrystalMine",
          "DeuteriumSynthesizer",
          "SolarPlant",
          "RoboticsFactory",
          "MetalStorage",
          "CrystalStorage",
          "DeuteriumTank"
        ]
      },
      "ConstructionDto": {
        "required": [
          "building",
          "targetLevel",
          "startedAt",
          "completesAt"
        ],
        "type": "object",
        "properties": {
          "building": {
            "$ref": "#/components/schemas/BuildingType"
          },
          "targetLevel": {
            "type": "integer",
            "format": "int32"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completesAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CoordinatesDto": {
        "required": [
          "galaxy",
          "system",
          "position"
        ],
        "type": "object",
        "properties": {
          "galaxy": {
            "type": "integer",
            "format": "int32"
          },
          "system": {
            "type": "integer",
            "format": "int32"
          },
          "position": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CurrentSeasonDto": {
        "required": [
          "id",
          "name",
          "startsAt",
          "endsAt",
          "player"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "player": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SeasonPlayerDto"
              }
            ]
          }
        }
      },
      "CurrentUserDto": {
        "required": [
          "id",
          "email"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "EnergyDto": {
        "required": [
          "produced",
          "consumed",
          "productionFactor"
        ],
        "type": "object",
        "properties": {
          "produced": {
            "type": "number",
            "format": "double"
          },
          "consumed": {
            "type": "number",
            "format": "double"
          },
          "productionFactor": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ForgotPasswordRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "InfoRequest": {
        "type": "object",
        "properties": {
          "newEmail": {
            "type": [
              "null",
              "string"
            ]
          },
          "newPassword": {
            "type": [
              "null",
              "string"
            ]
          },
          "oldPassword": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "InfoResponse": {
        "required": [
          "email",
          "isEmailConfirmed"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "isEmailConfirmed": {
            "type": "boolean"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "twoFactorCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "twoFactorRecoveryCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PlanetDto": {
        "required": [
          "id",
          "name",
          "coordinates",
          "maxTemperature",
          "resources",
          "resourcesAsOf",
          "hourlyProduction",
          "storageCapacity",
          "energy",
          "buildings",
          "construction",
          "serverTime"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "coordinates": {
            "$ref": "#/components/schemas/CoordinatesDto"
          },
          "maxTemperature": {
            "type": "integer",
            "format": "int32"
          },
          "resources": {
            "$ref": "#/components/schemas/ResourcesDto"
          },
          "resourcesAsOf": {
            "type": "string",
            "format": "date-time"
          },
          "hourlyProduction": {
            "$ref": "#/components/schemas/ResourcesDto"
          },
          "storageCapacity": {
            "$ref": "#/components/schemas/ResourcesDto"
          },
          "energy": {
            "$ref": "#/components/schemas/EnergyDto"
          },
          "buildings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BuildingDto"
            }
          },
          "construction": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ConstructionDto"
              }
            ]
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PlanetSummaryDto": {
        "required": [
          "id",
          "name",
          "coordinates"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "coordinates": {
            "$ref": "#/components/schemas/CoordinatesDto"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ResendConfirmationEmailRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "ResetPasswordRequest": {
        "required": [
          "email",
          "resetCode",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "resetCode": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "ResourcesDto": {
        "required": [
          "metal",
          "crystal",
          "deuterium"
        ],
        "type": "object",
        "properties": {
          "metal": {
            "type": "number",
            "format": "double"
          },
          "crystal": {
            "type": "number",
            "format": "double"
          },
          "deuterium": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SeasonPlayerDto": {
