          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/seasons/current": {
      "get": {
        "tags": [
          "Seasons"
        ],
        "description": "Get the season that is open right now, and whether the signed-in user has joined it",
        "operationId": "GetCurrentSeason",
