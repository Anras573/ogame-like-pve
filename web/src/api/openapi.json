  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "tokenType": {
            "type": [
              "null",
              "string"
            ]
          },
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          },
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "BuildingDto": {
        "required": [
          "type",
          "level",
          "nextLevelCost",
          "nextLevelBuildSeconds",
          "missingRequirements"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/BuildingType"
          },
          "level": {
            "type": "integer",
            "format": "int32"
          },
          "nextLevelCost": {
            "$ref": "#/components/schemas/ResourcesDto"
          },
          "nextLevelBuildSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "missingRequirements": {
            "$ref": "#/components/schemas/MissingRequirementsDto"
          }
        }
      },
      "BuildingLevelDto": {
        "required": [
          "building",
          "level"
        ],
        "type": "object",
        "properties": {
          "building": {
            "$ref": "#/components/schemas/BuildingType"
          },
          "level": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "BuildingType": {
        "enum": [
          "MetalMine",
          "CrystalMine",
          "DeuteriumSynthesizer",
          "SolarPlant",
          "RoboticsFactory",
          "MetalStorage",
          "CrystalStorage",
          "DeuteriumTank",
          "Shipyard",
          "ResearchLab"
        ]
      },
      "ConstructionDto": {
        "required": [
          "building",
          "targetLevel",
          "startedAt",
          "completesAt"
        ],
        "type": "object",
        "properties": {
          "building": {
            "$ref": "#/components/schemas/BuildingType"
          },
          "targetLevel": {
            "type": "integer",
            "format": "int32"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completesAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CoordinatesDto": {
        "required": [
          "galaxy",
          "system",
          "position"
        ],
        "type": "object",
        "properties": {
          "galaxy": {
            "type": "integer",
            "format": "int32"
          },
          "system": {
            "type": "integer",
            "format": "int32"
          },
          "position": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CurrentResearchDto": {
        "required": [
          "research",
          "targetLevel",
          "planetId",
          "startedAt",
          "completesAt"
        ],
        "type": "object",
        "properties": {
          "research": {
            "$ref": "#/components/schemas/ResearchType"
          },
          "targetLevel": {
            "type": "integer",
            "format": "int32"
          },
          "planetId": {
            "type": "string",
            "format": "uuid"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completesAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CurrentSeasonDto": {
        "required": [
          "id",
          "name",
          "startsAt",
          "endsAt",
          "player"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "player": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SeasonPlayerDto"
              }
            ]
          }
        }
      },
      "CurrentUserDto": {
        "required": [
          "id",
          "email"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "EnergyDto": {
        "required": [
          "produced",
          "consumed",
          "productionFactor"
        ],
        "type": "object",
        "properties": {
          "produced": {
            "type": "number",
            "format": "double"
          },
          "consumed": {
            "type": "number",
            "format": "double"
          },
          "productionFactor": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "EnqueueUnitsRequest": {
        "required": [
          "unit",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "unit": {
            "$ref": "#/components/schemas/UnitType"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ForgotPasswordRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
